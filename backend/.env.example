PORT=5000
NODE_ENV=development

MONGO_URI=mongodb://127.0.0.1:27019/rapidaid_demo
REDIS_URL=redis://127.0.0.1:6381/0

JWT_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

GOOGLE_MAPS_API_KEY=
GROQ_API_KEY=
CLIENT_URL=http://localhost:5173

# Demo fallback tuning. In production leave DEMO_MODE=false.
DEMO_MODE=false
ALLOW_DEMO_SEED=false
AMBULANCE_LOCATION_MAX_AGE_MS=90000
LOG_LEVEL=info
# Optional explicit override. Demo default=30s, normal default=120s.
# STALL_THRESHOLD_SECONDS=30


# Required to scrape /internal/metrics
METRICS_TOKEN=
