PORT=5000
NODE_ENV=development

MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/rapidaid
REDIS_URL=rediss://YOUR_REDIS_URL

JWT_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

GOOGLE_MAPS_API_KEY=
GROQ_API_KEY=
CLIENT_URL=http://localhost:5173

# Demo fallback tuning. In production leave DEMO_MODE=false.
DEMO_MODE=true
# Optional explicit override. Demo default=30s, normal default=120s.
# STALL_THRESHOLD_SECONDS=30

# Optional real hospital integration. If absent, L4 is audit-only.
HOSPITAL_WEBHOOK_URL=
